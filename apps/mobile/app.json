{
  "expo": {
    "name": "Citizens First Pune",
    "slug": "pune-traffic-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "citizensfirstpune",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Citizens First Pune uses the camera to attach traffic issue photos to citizen reports.",
        "NSPhotoLibraryUsageDescription": "Citizens First Pune uses photo library access to attach traffic issue photos to citizen reports.",
        "NSLocationWhenInUseUsageDescription": "Citizens First Pune uses your location to attach an approximate issue point to a traffic report."
      }
    },
    "android": {
      "package": "com.citizensfirstpune.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#f7f5ee"
      }
    },
    "extra": {
      "eas": {
        "projectId": "3ace4c3e-9134-4eb1-a526-40fb1e2e4d15"
      }
    },
    "owner": "abod-real-tech"
  }
}
